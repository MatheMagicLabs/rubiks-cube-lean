superflip_distance : (∀ (w : List Nat),
    (∀ (m : Nat), m ∈ w → m < 18) → applyList (eval superflip) w = St.id → 20 ≤ w.length) ∧
  (∀ (m : Nat), m ∈ superflip → m < 18) ∧ superflip.length = 20 ∧ applyList (eval superflip) superflip = St.id
gods_number_bounds : (∀ (w : List Nat),
    (∀ (m : Nat), m ∈ w → m < 18) → ∃ W, W.length ≤ 28 ∧ (∀ (m : Nat), m ∈ W → m < 18) ∧ applyList (eval w) W = St.id) ∧
  ∃ w,
    (∀ (m : Nat), m ∈ w → m < 18) ∧
      ∀ (W : List Nat), (∀ (m : Nat), m ∈ W → m < 18) → applyList (eval w) W = St.id → 20 ≤ W.length
