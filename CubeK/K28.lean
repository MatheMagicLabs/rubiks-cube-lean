def parseNats (t : String) : Array Nat := ((t.splitOn ",").map String.toNat!).toArray
def bad18L : List P := (bad18Str.splitOn " ").map (fun t => match t.splitOn ";" with
  | [c, e] => (parseNats c, parseNats e)
  | _ => (#[], #[]))
def bad18S : HashMap P Unit := bad18L.foldl (fun h p => h.insert p ()) ∅
def kbadF (_ : Unit) : HashMap P Unit := Id.run do
  let mut h : HashMap P Unit := HashMap.emptyWithCapacity 100000
  for y in bad18S.toList do
    let iy := pinv y.1
    for y' in bad18S.toList do
      h := h.insert (pmul iy y'.1) ()
  return h
/-- small facts: inverses of the bad elements, and the difference set is complete -/
def h4F (_ : Unit) : Bool :=
  let kb := kbadF ()
  bad18S.toList.all (fun y => bndOk y.1 && pmul (pinv y.1) y.1 == idP) &&
  bad18S.toList.all (fun y => bad18S.toList.all (fun y' => kb.contains (pmul (pinv y.1) y'.1)))

-- ---------- phase-1 distance 11: a pair of 11-move words per coset ----------
def dfsW (d : ByteArray) : Nat → Nat → Nat → List Nat → Array (List Nat) → Nat → Array (List Nat)
  | 0, i, _, acc, out, _ => if i == i0 then out.push acc.reverse else out
  | rem + 1, i, last, acc, out, cap =>
    (List.range 18).foldl (fun o m =>
      let f := m / 3
      if o.size ≥ cap || (last < 6 && (f == last || (f % 3 == last % 3 && f < last))) then o
      else
        let j := next i m
        if (d.get! j).toNat ≤ rem then dfsW d rem j f (m :: acc) o cap else o) out
def pairOk (kb : HashMap P Unit) (i : Nat) (w1 w2 : List Nat) : Bool :=
  wordOk i 11 w1 && wordOk i 11 w2 &&
  (let K1 := pActList idP w1
   let K2 := pActList idP w2
   let k := pmul (pinv K1) K2
   pmul K1 k == K2 && bndOk k && !kb.contains k)
def pairSlow (d : ByteArray) (kb : HashMap P Unit) (i : Nat) : Option (List Nat × List Nat) :=
  let sols := (dfsW d 11 i 6 [] #[] 12).toList
  let pairs := sols.flatMap (fun a => sols.map (fun b => (a, b)))
  pairs.find? (fun p => p.1 != p.2 && pairOk kb i p.1 p.2)
/-- first try the first two solutions found, then all pairs among up to 12 -/
def pair11 (d : ByteArray) (kb : HashMap P Unit) (i : Nat) : Option (List Nat × List Nat) :=
  match (dfsW d 11 i 6 [] #[] 2).toList with
  | [a, b] => if pairOk kb i a b then some (a, b) else pairSlow d kb i
  | _ => pairSlow d kb i
def cert11 (d : ByteArray) (kb : HashMap P Unit) (i : Nat) : Bool :=
  match pair11 d kb i with
  | some (w1, w2) => pairOk kb i w1 w2
  | none => false

