/-! A 28-move bound: Kociemba phase 1 then phase 2, where for phase-1 distance 11 and 12 several phase-1 solutions
of the same coset are combined. Elements of the phase-2 group are pairs of position arrays (corner, edge);
`pmul a b` composes them like `St.mul`. -/

def pmul (a b : P) : P :=
  ((List.range 8).toArray.map (fun i => a.1[b.1[i]!]!), (List.range 12).toArray.map (fun i => a.2[b.2[i]!]!))
def pinvA (a : Array Nat) (n : Nat) : Array Nat := Id.run do
  let mut r := Array.replicate n 0
  for i in [0:n] do r := r.set! a[i]! i
  return r
def pinv (a : P) : P := (pinvA a.1 8, pinvA a.2 12)
def bndOk (a : P) : Bool := a.1.size == 8 && a.2.size == 12 && a.1.all (· < 8) && a.2.all (· < 12)
def nextList (i : Nat) (w : List Nat) : Nat := w.foldl next i
/-- a phase-1 word for coset `i` of length `L`: legal moves, reaches the target cell -/
def wordOk (i L : Nat) (w : List Nat) : Bool := w.length == L && w.all (· < 18) && nextList i w == i0

/-- generic loop over `0 ≤ i < n` -/
def allBelow (f : Nat → Bool) : Nat → Bool
  | 0 => true
  | n + 1 => if f n then allBelow f n else false

