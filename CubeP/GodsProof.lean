import CubeP.GodsThm
open Std

section
variable {K : Type} [DecidableEq K] [Hashable K]

theorem actList_cons (act : K → Nat → K) (x : K) (h : Nat) (w : List Nat) :
    actList act x (h :: w) = actList act (act x h) w := rfl

theorem god_parts {t : HashMap K (List Nat)} {start : K} {act : K → Nat → K} {gens : List Nat} {bound : Nat}
    (hc : godCheck t start act gens bound = true) :
    t.toList.all (fun p => godEntryOk t start act gens bound p.1 p.2) = true ∧ t[start]? = some [] ∧
      t.toList.any (fun p => p.2.length == bound) = true := by
  unfold godCheck at hc
  simp only [Bool.and_eq_true, decide_eq_true_eq] at hc
  exact ⟨hc.1.1, hc.1.2, hc.2⟩

theorem god_entry {t : HashMap K (List Nat)} {start : K} {act : K → Nat → K} {gens : List Nat} {bound : Nat}
    (hc : godCheck t start act gens bound = true) {x : K} {v : List Nat} (hx : t[x]? = some v) :
    (∀ m ∈ v, m ∈ gens) ∧ v.length ≤ bound ∧ actList act start v = x ∧
      ∀ h ∈ gens, ∃ v', t[act x h]? = some v' ∧ v'.length ≤ v.length + 1 := by
  have hm : (x, v) ∈ t.toList := (HashMap.mem_toList_iff_getElem?_eq_some).2 hx
  have e := (List.all_eq_true.1 (god_parts hc).1) (x, v) hm
  unfold godEntryOk at e
  rw [Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true] at e
  obtain ⟨⟨⟨h1, h2⟩, h3⟩, h4⟩ := e
  refine ⟨?_, of_decide_eq_true h2, of_decide_eq_true h3, ?_⟩
  · intro m hm; exact List.contains_iff_mem.1 ((List.all_eq_true.1 h1) m hm)
  · intro h hh
    have hc' := (List.all_eq_true.1 h4) h hh
    revert hc'
    generalize t[act x h]? = q
    intro hc'
    cases q with
    | none => exact absurd hc' (by simp)
    | some v' => exact ⟨v', rfl, of_decide_eq_true hc'⟩

theorem god_reach {t : HashMap K (List Nat)} {start : K} {act : K → Nat → K} {gens : List Nat} {bound : Nat}
    (hc : godCheck t start act gens bound = true) (w : List Nat) (hw : ∀ m ∈ w, m ∈ gens) :
    ∀ x v, t[x]? = some v → ∃ v', t[actList act x w]? = some v' ∧ v'.length ≤ v.length + w.length := by
  induction w with
  | nil => intro x v hx; exact ⟨v, hx, by simp⟩
  | cons h w ih =>
    intro x v hx
    obtain ⟨v1, hv1, hl1⟩ := (god_entry hc hx).2.2.2 h (hw h (by simp))
    obtain ⟨v2, hv2, hl2⟩ := ih (fun m hm => hw m (by simp [hm])) (act x h) v1 hv1
    refine ⟨v2, by rw [actList_cons]; exact hv2, ?_⟩
    simp only [List.length_cons]; omega

/-- From a certificate: the exact God's number `bound` of the Cayley graph generated by `gens` from `start`. -/
theorem god_number {t : HashMap K (List Nat)} {start : K} {act : K → Nat → K} {gens : List Nat} {bound : Nat}
    (hc : godCheck t start act gens bound = true) :
    (∀ w, (∀ m ∈ w, m ∈ gens) → ∃ w', (∀ m ∈ w', m ∈ gens) ∧ w'.length ≤ bound ∧
        actList act start w' = actList act start w) ∧
    (∃ w0, (∀ m ∈ w0, m ∈ gens) ∧ ∀ w, (∀ m ∈ w, m ∈ gens) → actList act start w = actList act start w0 →
        bound ≤ w.length) := by
  constructor
  · intro w hw
    obtain ⟨v, hv, -⟩ := god_reach hc w hw start [] (god_parts hc).2.1
    obtain ⟨h1, h2, h3, -⟩ := god_entry hc hv
    exact ⟨v, h1, h2, h3⟩
  · obtain ⟨p, hp, hlen⟩ := List.any_eq_true.1 (god_parts hc).2.2
    have hx : t[p.1]? = some p.2 := (HashMap.mem_toList_iff_getElem?_eq_some).1 hp
    obtain ⟨h1, -, h3, -⟩ := god_entry hc hx
    refine ⟨p.2, h1, fun w hw he => ?_⟩
    obtain ⟨v, hv, hl⟩ := god_reach hc w hw start [] (god_parts hc).2.1
    rw [he, h3, hx] at hv
    cases hv
    simp only [beq_iff_eq] at hlen
    simp at hl
    omega
end

/-- **God's number of the 2×2×2 cube is 11 in the half-turn metric** (one corner fixed; moves U, R, F with all
powers). -/
theorem pocket_cube_htm :
    (∀ w, (∀ m ∈ w, m ∈ htm2) → ∃ w', (∀ m ∈ w', m ∈ htm2) ∧ w'.length ≤ 11 ∧
        actList c2Act c2Start w' = actList c2Act c2Start w) ∧
    (∃ w0, (∀ m ∈ w0, m ∈ htm2) ∧ ∀ w, (∀ m ∈ w, m ∈ htm2) → actList c2Act c2Start w = actList c2Act c2Start w0 →
        11 ≤ w.length) :=
  god_number (by have := c2Htm_true; unfold c2HtmCheckF at this; exact this)

/-- **God's number of the 2×2×2 cube is 14 in the quarter-turn metric.** -/
theorem pocket_cube_qtm :
    (∀ w, (∀ m ∈ w, m ∈ qtm2) → ∃ w', (∀ m ∈ w', m ∈ qtm2) ∧ w'.length ≤ 14 ∧
        actList c2Act c2Start w' = actList c2Act c2Start w) ∧
    (∃ w0, (∀ m ∈ w0, m ∈ qtm2) ∧ ∀ w, (∀ m ∈ w, m ∈ qtm2) → actList c2Act c2Start w = actList c2Act c2Start w0 →
        14 ≤ w.length) :=
  god_number (by have := c2Qtm_true; unfold c2QtmCheckF at this; exact this)

#print axioms pocket_cube_htm
#print axioms pocket_cube_qtm
